# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!ng

# AI Credits / OpenAI API Configuration
AICREDITS_API_KEY=your_aicredits_api_key_here
AICREDITS_BASE_URL=https://aicredits.in/v1
AI_MODEL=z-ai/glm-5.3-flash

# Tavily Web Search API
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Administration Permissions
# Comma-separated Discord user IDs who have full bot control regardless of guild roles
ADMIN_USER_IDS=
# Role name to treat as admin inside guilds (in addition to Administrator permission)
ADMIN_ROLE_NAME=Admin
